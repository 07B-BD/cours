insert into lecture_capteur (capteur_id, date_heure, valeur)
select
    c.id,
    timestamp '2026-02-17 07:30:00' + (gs.n * interval '15 minutes'),
    round(
        (
            case tc.nom
                when 'temperature' then
                    case
                        when e.nom = 'THM-B204' and gs.n >= 4 then 17.00
                        else 21.00 + ((e.id % 3)::numeric * 0.60) + (gs.n::numeric * 0.20)
                    end
                when 'presence' then
                    case
                        when gs.n between 2 and 6 and s.code in ('A-102', 'B-201', 'B-202', 'B-204', 'C-301') then 1
                        else 0
                    end
                when 'niveau_cafe' then
                    case
                        when e.nom = 'CAF-B204' and gs.n = 3 then 58
                        else 92 - (gs.n * 6) - ((e.id % 3) * 4)
                    end
                when 'papier' then 480 - (gs.n * 4) - ((e.id % 5) * 3)
                when 'ouverture' then
                    case
                        when gs.n in (0, 3, 5) then 1
                        else 0
                    end
                when 'consommation' then
                    case e.type_equipement
                        when 'thermostat' then
                            case
                                when e.nom = 'THM-B204' and gs.n >= 4 then 240
                                else 110 + (e.id % 4) * 8 + gs.n * 3
                            end
                        when 'porte' then 4 + (gs.n % 2)
                        when 'cafetiere' then
                            case
                                when e.nom = 'CAF-B204' and gs.n = 3 then 1820
                                else 760 + (e.id % 3) * 45 + gs.n * 12
                            end
                        when 'imprimante' then
                            case
                                when e.nom = 'IMP-B204' and gs.n between 3 and 5 then 310
                                else 95 + (e.id % 4) * 10 + gs.n * 5
                            end
                        when 'ordinateur' then 140 + (e.id % 5) * 12 + gs.n * 7
                        when 'lumiere' then 35 + (e.id % 3) * 4
                        else 0
                    end
                else 0
            end
        )::numeric,
        2
    )
from capteur c
join type_capteur tc on tc.id = c.type_capteur_id
join equipement e on e.id = c.equipement_id
join salle s on s.id = e.salle_id
cross join generate_series(0, 7) as gs(n);


drop type if exists type_equipement_enum cascade;

create type type_equipement_enum as enum (
    'thermostat',
    'porte',
    'cafetiere',
    'imprimante',
    'ordinateur',
    'lumiere'
);

create table salle (
    id serial primary key,
    code varchar(10) not null,
    nom varchar(100) not null,
    etage integer not null check (etage between 1 and 3)
);

create table equipement (
    id serial primary key,
    nom varchar(100) not null,
    type_equipement type_equipement_enum not null,
    salle_id integer not null references salle(id),
    est_actif boolean not null default true
);

create table type_capteur (
    id serial primary key,
    nom varchar(50) not null unique,
    unite varchar(20) not null
);

create table capteur (
    id serial primary key,
    code varchar(50) not null unique,
    equipement_id integer not null references equipement(id),
    type_capteur_id integer not null references type_capteur(id),
    est_actif boolean not null default true
);

create table lecture_capteur (
    id serial primary key,
    capteur_id integer not null,
    date_heure timestamp not null,
    valeur numeric(10,2) not null,
    constraint lecture_capteur_capteur_fk
        foreign key (capteur_id) references capteur(id)
);

create table type_decision (
    id serial primary key,
    nom varchar(50) not null unique
);

create table decision_ia (
    id serial primary key,
    type_decision_id integer not null references type_decision(id),
    equipement_id integer not null references equipement(id),
    date_heure timestamp not null,
    succes boolean not null
);

create table log_systeme (
    id serial primary key,
    date_heure timestamp not null,
    code_log varchar(50) not null,
    message varchar(255) not null,
    niveau varchar(20) not null,
    equipement_id integer references equipement(id)
);

create table utilisateur_systeme (
    id serial primary key,
    nom_utilisateur varchar(50),
    courriel varchar(150),
    niveau_acces varchar(20),
    mot_de_passe varchar(255) not null,
    actif boolean not null default true,
    dernier_acces timestamp
);

